rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 256;
      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId);

      // Conversations subcollection - strictly isolated to the authenticated owner
      match /conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(conversationId)
                      && request.resource.data.userId == userId
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 256
                      && request.resource.data.summary is string
                      && request.resource.data.summary.size() <= 4000
                      && request.resource.data.messages is list
                      && request.resource.data.messages.size() <= 200;
        allow update: if isOwner(userId) && isValidId(conversationId)
                      && request.resource.data.userId == userId
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 256
                      && request.resource.data.summary is string
                      && request.resource.data.summary.size() <= 4000
                      && request.resource.data.messages is list
                      && request.resource.data.messages.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Weekly reflections subcollection - strictly isolated to the authenticated owner
      match /reflections/{reflectionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reflectionId)
                      && request.resource.data.userId == userId
                      && request.resource.data.topics is list
                      && request.resource.data.learned is string
                      && request.resource.data.patterns is string
                      && request.resource.data.nextSteps is list
                      && request.resource.data.motivationalInsight is string;
        allow update: if isOwner(userId) && isValidId(reflectionId)
                      && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
