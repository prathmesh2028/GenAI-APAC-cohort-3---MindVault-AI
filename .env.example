# GEMINI_API_KEY: Required for Gemini AI API calls.
# In Cloud Run, set this as an environment variable or reference a Secret Manager secret.
GEMINI_API_KEY="your-gemini-api-key-here"

# GOOGLE CLOUD SECRET MANAGER (Optional)
# Set USE_SECRET_MANAGER=true to retrieve secrets dynamically from GCP Secret Manager
USE_SECRET_MANAGER=false
GCP_PROJECT_ID="onyx-philosophy-505508-d3"
GEMINI_SECRET_NAME="GEMINI_API_KEY"

# PORT: Cloud Run automatically injects PORT (defaults to 8080 in Cloud Run, 3000 in dev)
PORT=8080
NODE_ENV=production
